{
	"info": {
		"_postman_id": "ta-food-api-collection",
		"name": "TA-Food API",
		"description": "API Collection for TA-Food Authentication",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"123456\",\n    \"password_confirmation\": \"123456\",\n    \"name\": \"Test User\",\n    \"email\": \"test@example.com\",\n    \"phone\": \"0123456789\",\n    \"device_name\": \"postman\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"register"
							]
						},
						"description": "Đăng ký tài khoản mới"
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Lưu token vào environment variable",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.success && jsonData.data.token) {",
									"        pm.environment.set(\"auth_token\", jsonData.data.token);",
									"        console.log(\"Token saved: \" + jsonData.data.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"login\": \"testuser\",\n    \"password\": \"123456\",\n    \"device_name\": \"postman\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"login"
							]
						},
						"description": "Đăng nhập với username hoặc email"
					},
					"response": []
				},
				{
					"name": "Get User Info",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/user",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"user"
							]
						},
						"description": "Lấy thông tin user hiện tại (cần authentication)"
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"logout"
							]
						},
						"description": "Đăng xuất khỏi thiết bị hiện tại"
					},
					"response": []
				},
				{
					"name": "Logout All Devices",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/logout-all",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"logout-all"
							]
						},
						"description": "Đăng xuất khỏi tất cả thiết bị"
					},
					"response": []
				}
			]
		},
		{
			"name": "Home APIs",
			"item": [
				{
					"name": "Get Foods",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json"}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/foods?category=Cơm&search=chicken&page=1",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "foods"],
							"query": [
								{"key": "category", "value": "Cơm"},
								{"key": "search", "value": "chicken"},
								{"key": "page", "value": "1"}
							]
						},
						"description": "Lấy danh sách món ăn (phân trang, filter)"
					},
					"response": []
				},
				{
					"name": "Get Restaurants",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json"}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/restaurants?search=KFC&page=1",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "restaurants"],
							"query": [
								{"key": "search", "value": "KFC"},
								{"key": "page", "value": "1"}
							]
						},
						"description": "Lấy danh sách nhà hàng (kèm số lượng món còn bán)"
					},
					"response": []
				},
				{
					"name": "Get Offers",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json"}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/offers",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "offers"]
						},
						"description": "Lấy danh sách khuyến mãi"
					},
					"response": []
				},
				{
					"name": "Get Reviews",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json"}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/reviews",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "reviews"]
						},
						"description": "Lấy danh sách đánh giá khách hàng"
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "auth_token",
			"value": "",
			"type": "string"
		}
	]
}
