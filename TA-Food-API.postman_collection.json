							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"123456\",\n    \"password_confirmation\": \"123456\",\n    \"name\": \"Test User\",\n    \"email\": \"test@example.com\",\n    \"phone\": \"0123456789\",\n    \"device_name\": \"postman\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
